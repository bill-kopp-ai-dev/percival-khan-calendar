# Percival Khan Calendar — Environment Variables
# Copy to .env and edit for local development.
#
# All variables below are optional. Defaults are applied by
# `percival_khan_calendar.constants` at import time.

# Workspace directory. Defaults to ${XDG_DATA_HOME:-~/.local/share}/percival/khan-calendar.
# Existing workspaces require an explicit override; there is no automatic migration.
# KHAN_WORKSPACE_DIR=/home/your-user/.local/share/percival/khan-calendar

# IANA timezone. Defaults to America/Sao_Paulo; UTC is also supported.
# KHAN_TIMEZONE=America/Sao_Paulo

# Default calendar name. Defaults to "nanobot".
# KHAN_DEFAULT_CALENDAR=nanobot

# Locale settings (passed to khal.conf). Defaults shown.
# KHAN_TIMEFORMAT=%H:%M
# KHAN_DATEFORMAT=%d/%m/%Y

# Timeout (seconds) for khal subprocess calls. Defaults to 15.
# KHAN_SUBPROCESS_TIMEOUT=15

# Enable lock file on writes. Defaults to true; false is appropriate only
# when a single writer is guaranteed.
# KHAN_ENABLE_LOCK=true

# Log level. Defaults to INFO.
# KHAN_LOG_LEVEL=INFO
